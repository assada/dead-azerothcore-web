APP_NAME="AzerothCore"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Bind to loopback when a reverse proxy runs on the same host.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Comma-separated proxy IPs or CIDRs. Leave empty for direct HTTP access.
TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The website uses an existing AzerothCore installation.
# host.docker.internal reaches the Docker host on Linux, macOS, and Windows.
DB_CONNECTION=acore_auth
DB_AUTH_HOST=host.docker.internal
DB_AUTH_PORT=3306
DB_AUTH_DATABASE=acore_auth
DB_AUTH_USERNAME=azerothcore_web
DB_AUTH_PASSWORD=
DB_CHAR_HOST=host.docker.internal
DB_CHAR_PORT=3306
DB_CHAR_DATABASE=acore_characters
DB_CHAR_USERNAME=azerothcore_web
DB_CHAR_PASSWORD=
# The world database must be on the same MySQL server as characters.
DB_WORLD_DATABASE=acore_world

SESSION_DRIVER=database
SESSION_CONNECTION=acore_auth
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set true when APP_URL uses HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
QUEUE_CONNECTION=sync

# SMTP is required for verification, password resets, and email changes.
# Use MAIL_MAILER=log only for local development.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# One realm per installation. The realm ID must match AzerothCore.
REALM_DEFAULT_ID=1
REALM_NAME="${APP_NAME}"
REALM_SOAP_URL=
REALM_SOAP_USERNAME=
REALM_SOAP_PASSWORD=

WOW_REALMLIST="set realmlist logon.example.com"
WOW_CLIENT_URL=
WOW_RATE_XP=x1
WOW_RATE_DROP=x1
WOW_RATE_GOLD=x1
WOW_RATE_REP=x1
WOW_AUCTION_SHARED=true
WOW_TOOLTIP_URL=https://wowgaming.altervista.org/aowow

# Paths under public/ or absolute URLs. Empty values show the site name.
SITE_LOGO=
SITE_FAVICON=
SITE_DESCRIPTION=

WOW_REGISTRATION_ENABLED=true
WOW_COMMUNITY_PUBLIC=false
WOW_UNSTUCK_ENABLED=true
WOW_RENAME_ENABLED=true
WOW_CUSTOMIZE_ENABLED=true
# Rolling cooldowns use ISO 8601 durations. calendar_quarter resets at the
# next quarter in APP_TIMEZONE. P0D disables the cooldown.
WOW_UNSTUCK_COOLDOWN=PT3H
WOW_RENAME_COOLDOWN=P1Y
WOW_CUSTOMIZE_COOLDOWN=calendar_quarter
